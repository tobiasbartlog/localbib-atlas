{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.project/1",
  "title": "Atlas Project Frontmatter",
  "description": "YAML frontmatter of a project (projekte/*.md). Architektur Abschn. 4.3. Tasks are GFM checklists in the body, not a frontmatter field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "status"],
  "properties": {
    "schema": {
      "const": "atlas.project/1"
    },
    "id": {
      "type": "string",
      "description": "Immutable, equals filename without .md.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["idea", "active", "paused", "done"]
    },
    "derived_from": {
      "type": "array",
      "description": "Idea and/or dissertation-node IDs this project derives from.",
      "items": { "type": "string" },
      "default": []
    },
    "due": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
